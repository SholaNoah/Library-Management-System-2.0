<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" styleClass="root" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.StudentsController">

    <HBox spacing="10" styleClass="toolbar">
        <Button text="⬅ Back" fx:id="backButton"/>
        <Button text="🏠 Dashboard" fx:id="dashboardButton"/>
        <Button text="Add Student" fx:id="addStudentButton"/>
        <Button text="Edit Selected" fx:id="editStudentButton"/>
        <Button text="Delete Selected" fx:id="deleteStudentButton"/>
        <Button text="Refresh" fx:id="refreshButton"/>
    </HBox>

    <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="300"/>
        </columns>
    </TableView>

</VBox>