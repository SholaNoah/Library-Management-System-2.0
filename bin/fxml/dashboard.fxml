<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.DashboardController">

    <top>
        <ToolBar styleClass="toolbar">
            <Button text="Dashboard" fx:id="dashboardButton"/>
            <Button text="Books" fx:id="booksButton"/>
            <Button text="Students" fx:id="studentsButton"/>
            <Button text="Borrow" fx:id="borrowButton"/>
            <Button text="Return" fx:id="returnButton"/>
            <Button text="Fees" fx:id="feesButton"/>
            <Button text="Search" fx:id="searchButton"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="30" alignment="TOP_CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <VBox spacing="5" alignment="CENTER">
                <Label text="Library Management System" styleClass="title-label"/>
                <Label text="Welcome to LBMS 3.5 GUI Edition" styleClass="subtitle-label"/>
            </VBox>

            <HBox spacing="20" alignment="CENTER">
                <VBox styleClass="stat-card" alignment="CENTER" spacing="8">
                    <Label text="Total Books" styleClass="stat-label"/>
                    <Label fx:id="totalBooksLabel" text="—" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card" alignment="CENTER" spacing="8">
                    <Label text="Total Students" styleClass="stat-label"/>
                    <Label fx:id="totalStudentsLabel" text="—" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card" alignment="CENTER" spacing="8">
                    <Label text="Currently Borrowed" styleClass="stat-label"/>
                    <Label fx:id="activeBorrowsLabel" text="—" styleClass="stat-value"/>
                </VBox>

                <VBox fx:id="overdueCard" styleClass="stat-card" alignment="CENTER" spacing="8">
                    <Label text="Books Overdue" styleClass="stat-label"/>
                    <Label fx:id="overdueCountLabel" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <HBox spacing="20" alignment="CENTER">
                <VBox styleClass="stat-card-wide" alignment="CENTER_LEFT" spacing="8">
                    <Label text="📚 Most Borrowed Book" styleClass="stat-label"/>
                    <Label fx:id="mostBorrowedBookLabel" text="—" styleClass="stat-value-small"/>
                </VBox>

                <VBox fx:id="activeStudentCard" styleClass="stat-card-wide" alignment="CENTER_LEFT" spacing="8">
                    <Label text="🏅 Most Active Student" styleClass="stat-label"/>
                    <Label fx:id="mostActiveStudentLabel" text="—" styleClass="stat-value-small"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>