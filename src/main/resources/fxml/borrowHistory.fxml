<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" styleClass="root" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.BorrowHistoryController">

    <HBox spacing="10" styleClass="toolbar">
        <Button text="⬅ Back" fx:id="backButton"/>
        <Button text="🏠 Dashboard" fx:id="dashboardButton"/>
        <Button text="Refresh" fx:id="refreshButton"/>
    </HBox>

    <Label text="Borrow History" styleClass="title-label" style="-fx-padding: 10 0 0 15;"/>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="studentColumn" text="Student" prefWidth="180"/>
            <TableColumn fx:id="bookColumn" text="Book" prefWidth="220"/>
            <TableColumn fx:id="borrowDateColumn" text="Borrowed" prefWidth="110"/>
            <TableColumn fx:id="returnDateColumn" text="Returned" prefWidth="110"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
            <TableColumn fx:id="feeColumn" text="Fee (£)" prefWidth="80"/>
        </columns>
    </TableView>

</VBox>