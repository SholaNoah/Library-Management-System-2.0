<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" styleClass="root" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.OverdueController">

    <HBox spacing="10" styleClass="toolbar">
        <Button text="⬅ Back" fx:id="backButton"/>
        <Button text="🏠 Dashboard" fx:id="dashboardButton"/>
        <Button text="Refresh" fx:id="refreshButton"/>
    </HBox>

    <Label text="Overdue Books" styleClass="title-label" style="-fx-padding: 10 0 0 15;"/>

    <TableView fx:id="overdueTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="studentColumn" text="Student" prefWidth="180"/>
            <TableColumn fx:id="bookColumn" text="Book" prefWidth="220"/>
            <TableColumn fx:id="dueDateColumn" text="Due Date" prefWidth="120"/>
            <TableColumn fx:id="daysLateColumn" text="Days Late" prefWidth="100"/>
            <TableColumn fx:id="estimatedFeeColumn" text="Est. Fee (£)" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>